# Neon Postgres — pooled connection (used at runtime) and direct connection (used for migrations).
DATABASE_URL="postgresql://user:password@ep-example-pooler.region.aws.neon.tech/squadbid?sslmode=require"
DIRECT_URL="postgresql://user:password@ep-example.region.aws.neon.tech/squadbid?sslmode=require"

# NextAuth.js
NEXTAUTH_URL="http://localhost:3000"
NEXTAUTH_SECRET="replace-with-openssl-rand-base64-32"

# Optional: Google OAuth
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
